PROGRAM Safety
  ESTOP_CHAIN_OK := ESTOP_PB1_OK AND ESTOP_PB2_OK AND SAFETY_RELAY_FB;
  GUARDS_OK := GUARD_DOOR_1_CLOSED AND GUARD_DOOR_2_CLOSED;
  SAFE_TO_RUN := ESTOP_CHAIN_OK AND (GUARDS_OK OR MAINT_KEY_ON);
END_PROGRAM

PROGRAM Conveyors
  (* Downstream-first start: C3 before C2 before C1 *)
  M103_RUN := (START_PB OR M103_RUN) AND NOT STOP_PB AND SAFE_TO_RUN AND NOT M103_OVERLOAD;
  M102_RUN := (START_PB OR M102_RUN) AND NOT STOP_PB AND SAFE_TO_RUN AND NOT M102_OVERLOAD AND M103_RUN;
  M101_RUN := (START_PB OR M101_RUN) AND NOT STOP_PB AND SAFE_TO_RUN AND NOT M101_OVERLOAD AND M102_RUN AND NOT LS204_BIN_FULL;
  HORN := START_PB AND NOT SAFE_TO_RUN;
END_PROGRAM

PROGRAM Diverter
  Y301_DIVERT := DIVERT_REQ AND VALVE_ENABLE[STATION_IDX];
END_PROGRAM
